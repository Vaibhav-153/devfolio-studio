# Copy to .env.local and set these values from your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Your chosen root hostname only, no protocol, e.g. devfoliostudio.com.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Full application URL, used for auth confirmation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 4: REQUIRED for server-only publication image promotion.
# Never prefix this variable with NEXT_PUBLIC and never commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Deployment probes: set in shell, not as public client secrets.
# DEVFOLIO_PROBE_URL=https://staging.example.com
# DEVFOLIO_TEST_ENV=staging and STAGING_TEST_CONFIRM required for destructive staging tests

# Phase 6 staging only (do NOT set on production):
# STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_SUPABASE_PROJECT_REF
# DEVFOLIO_TEST_ENV=staging
# STAGING_TEST_CONFIRM=CREATE_AND_DELETE_TEST_USERS
# Read-only deployed probe (optional shell-only variables):
# DEVFOLIO_PROBE_URL=https://your-staging-domain.com/
# DEVFOLIO_ROOT_DOMAIN=your-staging-domain.com
# DEVFOLIO_PUBLIC_HANDLE=staging-demo
# DEVFOLIO_PROJECT_SLUG=sample-project
